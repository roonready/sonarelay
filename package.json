{
  "name": "sonarelay",
  "version": "1.2.1",
  "description": "SonaRelay - DLNA playback and Yandex Music browser",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "start": "electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "check": "vue-tsc --noEmit",
    "test": "node --test scripts/discovery.test.cjs scripts/playback.test.cjs scripts/live.test.cjs scripts/shutdown.test.cjs scripts/selection.test.cjs scripts/metadata.test.cjs scripts/bluos.test.cjs scripts/cast.test.cjs scripts/airplay2.test.cjs scripts/slimproto.test.cjs scripts/readiness.test.cjs scripts/receiver-order.test.cjs scripts/discovery-ui.test.cjs scripts/lastfm.test.cjs scripts/i18n.test.cjs scripts/updates.test.cjs scripts/radio.test.cjs scripts/profile.test.cjs scripts/radio-lastfm.test.cjs scripts/music-consent.test.cjs",
    "discover": "node scripts/discover.cjs",
    "test:capture": "node scripts/run-capture-smoke.cjs",
    "test:live": "node scripts/test-live.cjs",
    "dist": "node scripts/dist.cjs",
    "dist:unpacked": "node scripts/dist.cjs --unpacked",
    "test:background": "node scripts/run-background-smoke.cjs",
    "test:shutdown": "npm run build && node scripts/run-shutdown-smoke.cjs",
    "postinstall": "node scripts/patch-airplay.cjs && node scripts/patch-cast.cjs",
    "prebuild": "node scripts/patch-airplay.cjs && node scripts/patch-cast.cjs",
    "test:airplay:electron": "node scripts/run-airplay-electron-crypto.cjs",
    "release": "node scripts/release.cjs",
    "release:beta": "node scripts/release.cjs --channel beta",
    "release:stable": "node scripts/release.cjs --channel stable",
    "configure:github": "node scripts/configure-github.cjs",
    "github:create": "node scripts/create-github-repo.cjs",
    "test:radio:native": "node scripts/test-radio-native.cjs",
    "test:radio:ui": "node scripts/run-radio-ui-smoke.cjs"
  },
  "devDependencies": {
    "@types/multicast-dns": "^7.2.4",
    "@types/node": "^26.6.6",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@sonn-audio/node-airplay": "0.1.3",
    "@sonn-audio/node-slimproto": "0.1.4",
    "castv2-client": "^1.2.0",
    "electron-updater": "^6.8.11",
    "fast-xml-parser": "^5.12.1",
    "ffmpeg-static": "^5.3.0",
    "multicast-dns": "^7.2.5",
    "pinia": "^4.1.0",
    "semver": "^7.8.6",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.20"
  },
  "author": "SonaRelay",
  "overrides": {
    "castv2": {
      "protobufjs": "^8.8.1"
    }
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/roonready/sonarelay.git"
  },
  "homepage": "https://github.com/roonready/sonarelay",
  "bugs": {
    "url": "https://github.com/roonready/sonarelay/issues"
  }
}
