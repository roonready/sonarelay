{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "resolveJsonModule": true, "strict": true, "esModuleInterop": true, "skipLibCheck": true,
    "lib": ["ES2022", "DOM"], "types": ["node", "vite/client"], "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "electron.vite.config.ts"]
}
